# Copy to .env and adjust. Read by docker compose and by the app in the local profile.
# Never commit .env.

# Postgres
POSTGRES_DB=meterpay
POSTGRES_USER=meterpay
POSTGRES_PASSWORD=meterpay
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka (host listener)
KAFKA_PORT=9092

# API
SERVER_PORT=8080

# JWT signing secret, at least 32 bytes. Generate a new one per environment:
#   openssl rand -base64 48
JWT_SECRET=

# First admin, created at startup if no admin exists (DESIGN 17.3). Set all three or none:
# setting only some stops the app from starting. The password follows the registration rules.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
